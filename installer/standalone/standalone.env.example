# Aroomo 独立版（不需要 Docker）配置模板（D76–D79）。安装程序复制成 数据文件夹\config\aroomo.env 并填好随机密钥。
# 所有值都是占位符；CHANGE_ME 由安装程序换成随机值，sk-CHANGE_ME 换成 sk- 加随机值。这个文件本身不含任何密钥。
# 生成的 aroomo.env 只有当前 Windows 用户能读，并且随加密备份一起保存（D64 实现注 a）。

# ---- 通用 ----
TZ=Asia/Shanghai
AROOMO_EDITION=standalone

# ---- PostgreSQL 17 + pgvector（本机进程，只听 127.0.0.1）----
PG_PORT=54329
POSTGRES_PASSWORD=CHANGE_ME
LOBE_DB_NAME=lobechat
CORE_DB_PASSWORD=CHANGE_ME
LITELLM_DB_PASSWORD=CHANGE_ME

# ---- Redis（本机进程，只听 127.0.0.1）----
REDIS_PORT=63799
REDIS_PASSWORD=CHANGE_ME

# ---- 对象存储（RustFS，S3 兼容，只听 127.0.0.1）----
RUSTFS_PORT=9280
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_LOBE_BUCKET=lobe
S3_ENDPOINT=http://localhost:9280

# ---- 界面 ----
# 用户打开的是 Aroomo Shell（薄定制层）的端口；LobeHub 只在本机内部端口上
SHELL_PORT=3280
LOBE_PORT=3281
# 留空 = 默认（隐藏检查更新、更新日志、市场、欢迎建议、语音输入；D68）
LOBE_FEATURE_FLAGS=
KEY_VAULTS_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME
JWKS_KEY=
AUTH_ALLOWED_EMAILS=
# 全文搜索：独立版的 PostgreSQL 没有 ParadeDB 的 pg_search，用 LobeHub 支持的 pg_like（结果相同，数据很多时慢一些）
FTS_SEARCH_PROVIDER=pg_like

# ---- 模型网关：LiteLLM 本体（与服务器同一版本，D70）----
LITELLM_PORT=40280
# 管理密钥（只给 Core 用）
LITELLM_MASTER_KEY=sk-CHANGE_ME
# 加密 LiteLLM 里的供应商 Key；写入第一个 Key 后不能更换（它随加密备份保存）
LITELLM_SALT_KEY=sk-CHANGE_ME
# LobeHub 调用模型用的虚拟 Key（只能调用模型，启动器第一次启动时在 LiteLLM 里建好）
LOBE_LITELLM_VIRTUAL_KEY=sk-CHANGE_ME

# ---- Core ----
CORE_PORT=38280
CORE_LOG_LEVEL=info
CORE_OWNER_TOKEN=CHANGE_ME
CORE_TOKEN_SECRET=CHANGE_ME
# 本机没有 Cloudflare Access（D63 本地版）
CORE_ACCESS_REAUTH=off

# ---- 备份（D64、D65）----
# 主密钥的公钥（age1 开头）。主密钥本身（AGE-SECRET-KEY-1 开头）绝不能写进这个文件
BACKUP_AGE_RECIPIENT=
BACKUP_HOST_TAG=standalone
BACKUP_LOCAL_KEEP=3
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pc/pc
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
RETENTION_KEEP_LAST=3
RETENTION_KEEP_DAILY=7
RETENTION_KEEP_WEEKLY=4
RETENTION_KEEP_MONTHLY=6
