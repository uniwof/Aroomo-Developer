# Aroomo 环境变量模板。复制为 deploy/.env 后填写；.env 已被 .gitignore 忽略，绝不提交。
# 所有值均为占位符。随机值可用：openssl rand -hex 32
# 凭据（Cloudflare 令牌、备份密钥、模型 Key）由用户通过安全表单交付，不经过聊天（PRODUCT 0.4、§19）。

# ---- 通用 ----
TZ=Asia/Shanghai
# 数据目录（仅叠加 data-dir.yml 时使用；必须是绝对路径）
# DATA_DIR=/srv/aroomo
# 服务器：COMPOSE_PROFILES=tunnel,backup ；本机：留空
COMPOSE_PROFILES=

# ---- PostgreSQL ----
POSTGRES_PASSWORD=CHANGE_ME
LOBE_DB_NAME=lobechat
LITELLM_DB_PASSWORD=CHANGE_ME
CORE_DB_PASSWORD=CHANGE_ME

# ---- 对象存储（RustFS，S3 兼容）----
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
RUSTFS_LOBE_BUCKET=lobe
# 浏览器能访问到的对象存储地址：本机 http://localhost:9000；服务器为经 Tunnel 的对象存储域名
S3_ENDPOINT=http://localhost:9000

# ---- LobeHub ----
# 本机 http://localhost:3210；服务器为经 Tunnel 的应用域名（https）
APP_URL=http://localhost:3210
# 必须是 base64 解码后 32 字节：openssl rand -base64 32（十六进制会被 LobeHub 拒绝）
KEY_VAULTS_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME
# RS256 JWKS（LobeHub 官方 setup.sh 会生成；格式见 LobeHub 文档）
JWKS_KEY=
JWKS_PUBLIC_KEY=
# 只允许这些邮箱登录（单用户）
AUTH_ALLOWED_EMAILS=
# 【SHELL_AUTH=lobe-session 时必填】所有者的 LobeHub 用户 id：只有这个用户能用控制台 / Aroomo 接口（#245）。core-session 时不用。
# 获取：所有者登录后在浏览器打开 /api/auth/get-session，复制 user.id。留空 = 控制台对所有人 403。
SHELL_OWNER_USER_ID=
# 【生产必填】Shell 登录方式：core-session（默认，Aroomo Core 账号）或 lobe-session（旧 LobeHub 登录，只作回退）
# SHELL_AUTH=core-session
# 【生产必填】所有者的 Aroomo Core 账号邮箱（core-session）：只有这个邮箱、且角色是管理员，才能用控制台。留空 = 对所有人 403。
SHELL_OWNER_EMAIL=
# 登录限速按「邮箱 + 真实来源 IP」算（#259）。默认已在 compose 里设好，一般不用改：
#   Shell 从 cf-connecting-ip 取浏览器 IP（只在直连方是容器网络 / 本机时才信）；Core 只信任容器网络里的上一跳（uniquelocal）。
#   前面换成 nginx 时改 SHELL_CLIENT_IP_HEADER=x-real-ip。
# SHELL_CLIENT_IP_HEADER=cf-connecting-ip
# CORE_TRUST_PROXY=uniquelocal
# LobeHub 的对话经 Core /v1 → LiteLLM（提议 H5），用下面的 CORE_CHAT_TOKEN，这里不用填。
# 只有撤回 H5、让 LobeHub 直连 LiteLLM 时才设置：
# LOBE_OPENAI_PROXY_URL=http://litellm:4000/v1
# LOBE_OPENAI_API_KEY=
LOBE_ENABLE_AGENT_GATEWAY=0
GATEWAY_SERVICE_TOKEN=
# Agent Gateway 地址。留空 = 默认 http://gateway:8787（空值会让 LobeHub 报 Invalid URL，compose 已兜底）
# AGENT_GATEWAY_URL=

# ---- LiteLLM ----
# 管理密钥，必须以 sk- 开头
LITELLM_MASTER_KEY=sk-CHANGE_ME
# 加密数据库中供应商 Key 的盐；写入第一个模型后永远不能更换，务必离线另存一份
LITELLM_SALT_KEY=sk-CHANGE_ME
LITELLM_NUM_WORKERS=1

# ---- Core ----
CORE_LOG_LEVEL=info
# 访问 Core /api 的主人令牌（P0 单用户，≥32 字符；openssl rand -hex 32）。不设置时 /api 一律 503
CORE_OWNER_TOKEN=CHANGE_ME
# 方案 A：所有者自己的 Core 账号 id（UUID，users.id）。她用控制台登录时看到并使用所有者名下的成员、用量、设置。
# 必须与 SHELL_OWNER_EMAIL 是同一个账号、且是启用的管理员（Core 启动检查 + release-precheck 检查 6）。留空 = 不映射
CORE_OWNER_ACCOUNT_ID=
# 助手定时执行器：true 才开；不写 = 关（docker-compose 默认 false）。生产阶段 3 前不要打开
# ASSISTANT_SCHEDULER_ENABLED=false
# X-19 长会话自动压缩（自动调免费成员做摘要，每天最多 40 次）：true 才开；不写 = 关。生产阶段 1.5 不要打开
# COMPACT_ENABLED=false
# 对话入口 /v1 的令牌（LobeHub → Core，≥32 字符）。不设置时对话一律 503
CORE_CHAT_TOKEN=CHANGE_ME
# 操作员令牌 HMAC 用的服务端密钥（≥32 字符；openssl rand -hex 32）。留空则操作员令牌不可用
CORE_TOKEN_SECRET=
# 保险箱（工具密钥）信封加密的主密钥：32 字节 base64。生成：openssl rand -base64 32
# 添加第一条保险箱记录前必须设好，之后不能丢也不能换（丢了=保险箱里的东西全部解不开）。只放在服务器 .env，权限 600，随加密备份一起保存。
VAULT_KEY=
# 统一确认（D63）：涉及凭据的操作（新增 / 替换 / 删除 Key）第二次点击前要重新验证 Cloudflare Access。
#   CF_ACCESS_TEAM_DOMAIN：团队域名，如 myteam.cloudflareaccess.com；CF_ACCESS_AUD：Access 应用的 AUD 标签（两者一起设置）
#   CORE_ACCESS_REAUTH：required（服务器，默认；没配 Access 时凭据操作直接拒绝）| off（本地版，没有 Access）
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CORE_ACCESS_REAUTH=required
CORE_ACCESS_REAUTH_MAX_AGE_S=300
# X-08 推送提醒（手机锁屏收「有事等你确认」「助手运行完成」）。默认关；改成 true 时下面三项必须一起设。
#   生成密钥：node scripts/gen-vapid-keys.mjs（打印三行，贴到这里）。私钥只放服务器 .env；换密钥后所有设备要在设置里重新打开。
#   VAPID_SUBJECT：mailto:你的邮箱（推送服务出问题时联系谁）。iPhone 要先「添加到主屏幕」才收得到，见 docs/ops/push.md
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---- Cloudflare Tunnel（profile: tunnel）----
CLOUDFLARE_TUNNEL_TOKEN=

# ---- 备份（profile: backup / restore；异地目标必须在 AWS 之外，D49）----
# 加密：用主密钥的公钥（age1 开头，D64）。主密钥（AGE-SECRET-KEY-1 开头的私钥）由用户离线保管，
# 只在恢复时临时提供，绝不能写进这个文件。公钥由 Windows 安装程序生成主密钥时显示。
BACKUP_AGE_RECIPIENT=
# 异地存储（S3 兼容，见 docs/ops/BACKUP.md）：
#   Cloudflare R2：BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  BACKUP_S3_REGION=auto
#   Backblaze B2 ：BACKUP_S3_ENDPOINT=https://s3.<region>.backblazeb2.com            BACKUP_S3_REGION=<region>
# 服务器写 server/，电脑版写 pc/<电脑名>/（D65：同一个桶，独立目录）
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=server
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_CRON=30 3 * * *
# 异地保留策略：最近 N 个 / 每天 / 每周 / 每月各保留几个（0 = 不按该项保留）
RETENTION_KEEP_LAST=0
RETENTION_KEEP_DAILY=7
RETENTION_KEEP_WEEKLY=4
RETENTION_KEEP_MONTHLY=6
# 完整性检查（重新下载最新一份，核对 SHA-256 和文件头）：weekly（每周日）| always | never
BACKUP_CHECK=weekly

# ---- 监控（profile: monitoring；独立部署脚本 scripts/deploy-monitoring.sh）----
# Gatus Basic Authentication 账号密码
GATUS_USER=admin
GATUS_PASSWORD=CHANGE_ME
# Beszel Agent 密钥（在 Beszel Hub 创建 System 后获得）
BESZEL_AGENT_KEY=
